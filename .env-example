# ============================================================
# FeatherTalk environment variables
# Copy this file to .env and fill in your values.
# ============================================================

# --- Training pipeline: conda environment ---
# Path to Miniconda/Anaconda base on the host (mounted read-only into the container)
CONDA_BASE=/home/ultimate/miniconda3
# Name of the conda environment used by TBDub
TBDUB_CONDA_ENV=tbdub

# --- Training pipeline: email notifications ---
# SMTP server hostname
SMTP_SERVER=smtp.gmail.com
# SMTP port (587 = STARTTLS, 465 = SSL)
SMTP_PORT=465
# Sender email address (also used as SMTP login)
SMTP_SENDER=bdavatargen@gmail.com
# SMTP password
SMTP_PWD=

# URL embedded in notification emails (button "Open FeatherTalk")
APP_URL=https://feathertalk.ultimate.borndigital.ai/

# --- Realtime streaming (optional overrides) ---
# Transport protocol: "webrtc" (default) or "patches"
# FEATHER_REALTIME_TRANSPORT=webrtc
# UNet batch size for local idle rendering (1–8)
# FEATHER_REALTIME_UNET_BATCH=1
# WebRTC video bitrate in bps (default 8 Mbit/s)
# FEATHER_WEBRTC_BITRATE=8000000

# --- WebRTC ICE / STUN / TURN ---
FEATHER_WEBRTC_ICE_SERVERS='[{"urls":"stun:stun.l.google.com:19302"}]'
FEATHER_WEBRTC_STUN_SERVER=stun://stun.l.google.com:19302

TURN_SERVER_URLS=turns:turn.borndigital.ai:443?transport=tcp
TURN_SERVER_USERNAME=
TURN_SERVER_PASSWORD=
